{
  "specification": {
    "version": "1.0",
    "inputs": [
      {
        "type": "InferenceImage",
        "name": "image"
      },
      {
        "type": "WorkflowParameter",
        "name": "confidence",
        "default_value": 0.4
      },
      {
        "type": "WorkflowParameter",
        "name": "iou_threshold",
        "default_value": 0.3
      },
      {
        "type": "WorkflowParameter",
        "name": "class_agnostic_nms",
        "default_value": false
      },
      {
        "type": "WorkflowParameter",
        "name": "max_detections",
        "default_value": 1000
      },
      {
        "type": "WorkflowParameter",
        "name": "model_id",
        "default_value": "disc-golf-tracer/disc-golf-flight-tracker-2-rfdetr-small-t1"
      }
    ],
    "steps": [
      {
        "type": "roboflow_core/roboflow_object_detection_model@v3",
        "name": "model",
        "images": "$inputs.image",
        "model_id": "$inputs.model_id",
        "confidence_mode": "custom",
        "custom_confidence": "$inputs.confidence",
        "iou_threshold": "$inputs.iou_threshold",
        "class_agnostic_nms": "$inputs.class_agnostic_nms",
        "max_detections": "$inputs.max_detections"
      }
    ],
    "outputs": [
      {
        "type": "JsonField",
        "name": "predictions",
        "coordinates_system": "own",
        "selector": "$steps.model.predictions"
      },
      {
        "type": "JsonField",
        "name": "inference_id",
        "coordinates_system": "own",
        "selector": "$steps.model.inference_id"
      },
      {
        "type": "JsonField",
        "name": "model_id",
        "coordinates_system": "own",
        "selector": "$steps.model.model_id"
      }
    ]
  }
}
