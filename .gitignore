# Root ignores only — do not duplicate rules that already live in
# disc_golf_android/.gitignore, so there is one owner per rule.

# Build output (Flutter, Gradle)
build/
**/build/
.gradle/

# Node — this repo has no JavaScript source. These directories only ever
# appear by accident; a stray empty pnpm lockfile was previously committed.
node_modules/
package-lock.json
pnpm-lock.yaml
yarn.lock

# Python (scripts only)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Flight benchmark downloads (videos, frames, dataset exports)
tools/flight-bench/data/

# Local environment
.env
.env.local

# Editor / OS
.DS_Store
Thumbs.db
*.swp
