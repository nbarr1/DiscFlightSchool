# Copy this file to server/.env and replace every placeholder before running
# anything reachable from outside your machine.
#
# docker-compose.yml reads this file for non-secret defaults but requires
# APP_API_KEY, POSTGRES_*, and OBJECT_STORAGE_ROOT_* to be set in your shell,
# so the
# placeholders below can never be used as live credentials by accident.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=replace-with-a-long-random-secret
CORS_ALLOW_ORIGINS=http://localhost:8000
MAX_UPLOAD_BYTES=8388608
TRAINING_TIMEOUT_SECONDS=7200
MODEL_EXPORT_TIMEOUT_SECONDS=600
TRAINING_EPOCHS=50
TRAINING_IMAGE_SIZE=640
TRAINING_BATCH_SIZE=16
DATABASE_URL=postgresql://discflight:change-me-postgres-password@postgres:5432/discflight
REDIS_URL=redis://redis:6379/0
OBJECT_STORAGE_ENDPOINT=http://object-storage:9000
OBJECT_STORAGE_BUCKET=disc-flight-school
OBJECT_STORAGE_ACCESS_KEY=change-me-object-store-user
OBJECT_STORAGE_SECRET_KEY=change-me-object-store-password
OBJECT_STORAGE_SECURE=false
WORKER_POLL_SECONDS=30

# Server-only. Never expose this value through Android resources or client config.
ROBOFLOW_API_KEY=replace-with-a-server-side-roboflow-key
# Optional. The Android app ships with this key, so the server accepts it only
# on the Roboflow endpoints, never for training upload, export, or start.
# Leave it empty to require APP_API_KEY everywhere.
CLIENT_API_KEY=
# Optional. A key that opens only POST /api/training/upload, for people who
# contribute samples but shouldn't export the dataset or start training.
UPLOAD_API_KEY=
# Spending limits on the client key, which anyone can extract from the app.
# Requests with APP_API_KEY are never limited.
DISC_FLIGHT_MAX_ACTIVE_JOBS=3
CLIENT_RATE_LIMIT_PER_HOUR=30
CLIENT_GLOBAL_LIMIT_PER_HOUR=300
# Proxies in front of the server that append to X-Forwarded-For: 1 behind
# Render or one Cloudflare Tunnel, 0 when clients connect directly. Too high a
# value lets callers pick their own address and dodge the per-caller limit.
TRUSTED_PROXY_HOPS=0
# Lower this behind a proxy that caps request bodies below it: a free
# Cloudflare Tunnel cuts off at 100 MB. docker-compose.yml reads a shell
# override of the same name, so you need not edit this file.
DISC_FLIGHT_MAX_UPLOAD_BYTES=209715200
DISC_FLIGHT_SESSION_TIMEOUT_SECONDS=900

# Local compose credentials. Replace before running any shared or reachable stack.
POSTGRES_DB=discflight
POSTGRES_USER=discflight
POSTGRES_PASSWORD=change-me-postgres-password
OBJECT_STORAGE_ROOT_USER=change-me-object-store-user
OBJECT_STORAGE_ROOT_PASSWORD=change-me-object-store-password
